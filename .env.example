# Se completa solo con `npm run env:local` (lee `supabase status`).
# Son valores de Supabase LOCAL; nunca pongas aquí datos de un proyecto remoto.

# Usados por la app
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Usados solo por los tests (nunca por la app)
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55322/postgres
